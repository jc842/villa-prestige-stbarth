---
import ReviveSlot from '../../components/ads/ReviveSlot.astro';
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout title={post.data.title + ' — Villa Prestige Saint-Barth'} description={post.data.description}>
  <article class="py-14 bg-[#060606]">
    <div class="mx-auto max-w-3xl px-4 sm:px-6">
      
      <!-- Breadcrumb -->
      <div class="flex items-center gap-2 text-xs text-stone-400 mb-8 font-semibold">
        <a href="/" class="hover:text-[#d4af37]">Accueil</a>
        <span>/</span>
        <a href="/blog/" class="hover:text-[#d4af37]">Domaines</a>
        <span>/</span>
        <span class="text-[#d4af37]">{post.data.category || 'Saint-Barth'}</span>
      </div>

      <!-- Header -->
      <header class="border-b border-stone-800 pb-8 mb-8">
        <span class="text-[11px] uppercase tracking-widest text-[#d4af37] font-semibold mb-3 block">VILLA PRESTIGE PRIVATE COLLECTION</span>
        <h1 class="font-serif-luxury text-2xl sm:text-4xl font-bold text-white tracking-tight leading-snug">
          {post.data.title}
        </h1>
        <div class="mt-4 flex items-center gap-4 text-xs text-stone-400">
          <span>Publié le {new Date(post.data.pubDate).toLocaleDateString('fr-FR', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
          <span>•</span>
          <span class="italic font-serif-luxury">Par la Direction Villa Prestige St-Barth</span>
        </div>
      </header>

      <!-- Content -->
      <div class="prose prose-invert prose-stone max-w-none prose-headings:font-serif-luxury prose-headings:font-bold prose-headings:text-white prose-a:text-[#d4af37] leading-relaxed text-stone-300 font-light text-base">
        <Content />

      <!-- Encart Pub In-Content Revive (Medium Rectangle) -->
      <div class="my-12 py-6 border-y border-stone-200/80 dark:border-stone-800 flex justify-center">
        <ReviveSlot slot="inContent" />
      </div>

      <!-- Encart Pub Fin d'Article Large Rectangle -->
      <div class="my-8 p-4 bg-stone-50/60 dark:bg-stone-900/60 rounded-2xl border border-stone-200/60 dark:border-stone-800 flex flex-col items-center justify-center text-center">
        <ReviveSlot slot="largeRectangle" />
      </div>
      </div>

      <!-- Footer -->
      <footer class="mt-14 border-t border-stone-800 pt-8 text-xs flex justify-between items-center text-stone-400">
        <a href="/blog/" class="text-[#d4af37] hover:underline font-semibold uppercase tracking-wider text-[11px]">← Retour aux domaines</a>
        <span class="font-serif-luxury italic text-[#d4af37]">Villa Prestige Saint-Barth</span>
      </footer>
    </div>
  </article>
</Layout>
