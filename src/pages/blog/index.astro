---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const sortedPosts = posts.sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());
---

<Layout title="Toutes les Fiches et Dossiers de Villas de Prestige à Saint-Barth — Villa Prestige Saint-Barth">
  <section class="border-b border-stone-800 bg-[#060606] py-14">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="inline-flex items-center gap-2 rounded-full border border-[#d4af37]/30 bg-[#16140e] px-3 py-1 text-xs text-[#e5c76b] font-semibold mb-4">
        INDEX DES DOMAINES
      </div>
      <h1 class="font-serif-luxury text-3xl font-bold text-white sm:text-4xl">Collection Complète des Domaines & Villas d'Exception</h1>
      <p class="mt-3 max-w-2xl text-stone-400 text-sm font-light">
        Explorez nos chroniques d'architecture insulaire, sélections de propriétés de villégiature et services exclusifs à Saint-Barthélemy.
      </p>
    </div>
  </section>

  <section class="py-12 bg-[#060606]">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {sortedPosts.map(post => (
          <article class="flex flex-col justify-between rounded-sm border border-stone-800 bg-[#0c0c0c] p-6 hover:border-[#d4af37]/50 transition-colors">
            <div>
              <div class="flex items-center justify-between text-[11px] text-stone-400 mb-3">
                <span class="rounded bg-[#1a1710] px-2 py-0.5 text-[#e5c76b] font-semibold text-[10px] uppercase">{post.data.category || 'Domaine'}</span>
                <span>{new Date(post.data.pubDate).toLocaleDateString('fr-FR', { year: 'numeric', month: 'short', day: 'numeric' })}</span>
              </div>
              <h2 class="font-serif-luxury text-lg font-bold text-white hover:text-[#d4af37] transition-colors line-clamp-2">
                <a href={'/blog/' + post.id + '/'}>{post.data.title}</a>
              </h2>
              <p class="mt-2 text-xs text-stone-400 line-clamp-3 leading-relaxed font-light">
                {post.data.description}
              </p>
            </div>
            <div class="mt-5 pt-4 border-t border-stone-800 flex justify-end text-xs">
              <a href={'/blog/' + post.id + '/'} class="text-[#d4af37] hover:underline font-semibold uppercase text-[11px] tracking-wider">
                Découvrir →
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>
