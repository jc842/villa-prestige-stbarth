---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const sortedPosts = posts.sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());
const featuredPosts = sortedPosts.slice(0, 6);
const remainingPosts = sortedPosts.slice(6, 40);
---

<Layout title="Villa Prestige Saint-Barth — Collection Exclusive de Villas d'Exception & Séjours Privés à Saint-Barthélemy">
  <!-- Hero Section Semplice -->
  <section class="relative border-b border-stone-800 bg-[#060606] py-16 sm:py-24 overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-[#d4af37]/10 via-transparent to-transparent"></div>
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6">
      
      <!-- Top Pill -->
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-[#d4af37]/30 bg-[#16140e] px-3.5 py-1.5 text-xs text-[#e5c76b] font-medium">
        <span class="h-2 w-2 rounded-full bg-[#d4af37]"></span>
        VILLÉGIATURE CONFIDENTIELLE DE HAUTE VOLÉE
      </div>

      <!-- Headline -->
      <h1 class="font-serif-luxury text-3xl sm:text-5xl lg:text-6xl max-w-4xl leading-tight font-normal text-white">
        L'Excellence et la Sérénité des Plus Belles <span class="italic text-[#d4af37]">Villas de Saint-Barth</span>.
      </h1>

      <p class="mt-6 max-w-2xl text-base sm:text-lg text-stone-300 leading-relaxed font-light">
        Domaines perchés sur les falaises de Gustavia, demeures d'architectes les pieds dans l'eau à Saint-Jean et conciergerie privée disponible à chaque instant.
      </p>

      <!-- Key Pillars Row -->
      <div class="mt-12 grid grid-cols-2 gap-4 sm:grid-cols-4 lg:gap-6">
        <div class="rounded-sm border border-stone-800 bg-[#0f0f0f]/80 p-6 backdrop-blur-sm">
          <div class="text-[10px] text-[#d4af37] uppercase tracking-widest font-semibold">Domaines Secrets</div>
          <div class="mt-2 font-serif-luxury text-2xl font-bold text-white">Cliffside Villas</div>
          <div class="mt-1 text-xs text-stone-400">Piscines infinies miroir</div>
        </div>
        <div class="rounded-sm border border-stone-800 bg-[#0f0f0f]/80 p-6 backdrop-blur-sm">
          <div class="text-[10px] text-[#d4af37] uppercase tracking-widest font-semibold">Gastronomie Privée</div>
          <div class="mt-2 font-serif-luxury text-2xl font-bold text-[#e5c76b]">Chefs Dédiés</div>
          <div class="mt-1 text-xs text-stone-400">Haute cuisine dans votre villa</div>
        </div>
        <div class="rounded-sm border border-stone-800 bg-[#0f0f0f]/80 p-6 backdrop-blur-sm">
          <div class="text-[10px] text-[#d4af37] uppercase tracking-widest font-semibold">Service Personnalisé</div>
          <div class="mt-2 font-serif-luxury text-2xl font-bold text-white">24h / 24</div>
          <div class="mt-1 text-xs text-stone-400">Majordome & conciergerie</div>
        </div>
        <div class="rounded-sm border border-stone-800 bg-[#0f0f0f]/80 p-6 backdrop-blur-sm">
          <div class="text-[10px] text-[#d4af37] uppercase tracking-widest font-semibold">Confidentialité</div>
          <div class="mt-2 font-serif-luxury text-2xl font-bold text-[#d4af37]">100% Privé</div>
          <div class="mt-1 text-xs text-stone-400">Discrétion absolue garantie</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Bento Articles -->
  <section class="py-16 sm:py-20 bg-[#060606] border-b border-stone-800">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="flex items-center justify-between mb-10">
        <div>
          <span class="text-xs uppercase tracking-widest text-[#d4af37] font-semibold">Collection Privée</span>
          <h2 class="font-serif-luxury text-2xl font-bold text-white sm:text-3xl mt-1">Dernières Propriétés & Chroniques d'Exception</h2>
        </div>
        <a href="/blog/" class="hidden sm:inline-flex items-center gap-2 text-xs text-[#d4af37] hover:underline font-semibold tracking-wider uppercase">
          TOUTES LES PUBLICATIONS →
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {featuredPosts.map((post) => (
          <article class="group relative flex flex-col justify-between rounded-sm border border-stone-800/90 bg-[#0c0c0c] p-7 transition-all duration-300 hover:border-[#d4af37]/40 hover:bg-[#121212]">
            <div>
              <div class="flex items-center justify-between text-[11px] text-stone-400 mb-4">
                <span class="rounded bg-[#1a1710] px-2.5 py-0.5 text-[#e5c76b] font-semibold text-[10px] uppercase tracking-wider">{post.data.category || 'Domaine'}</span>
                <span>{new Date(post.data.pubDate).toLocaleDateString('fr-FR', { year: 'numeric', month: 'short', day: 'numeric' })}</span>
              </div>
              <h3 class="font-serif-luxury text-xl font-bold text-white group-hover:text-[#d4af37] transition-colors line-clamp-2 leading-snug">
                <a href={'/blog/' + post.id + '/'}>
                  {post.data.title}
                </a>
              </h3>
              <p class="mt-3 text-xs text-stone-400 line-clamp-3 leading-relaxed font-light">
                {post.data.description}
              </p>
            </div>
            <div class="mt-6 pt-4 border-t border-stone-800/80 flex items-center justify-between text-xs">
              <span class="text-stone-500 font-serif-luxury italic">Villa Prestige Dossier</span>
              <a href={'/blog/' + post.id + '/'} class="text-[#d4af37] hover:underline font-semibold text-[11px] tracking-wider uppercase">
                Consulter →
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Extended Library -->
  <section class="py-16 bg-[#030303]">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <h2 class="font-serif-luxury text-2xl font-bold text-white mb-8">
        L'Art de Vivre Insulaire : Domaines, Services & Rituels
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {remainingPosts.map(post => (
          <div class="flex items-start justify-between rounded-sm border border-stone-800/80 bg-[#0a0a0a] p-4 hover:border-[#d4af37]/30 transition-colors">
            <div class="pr-4">
              <span class="text-[9px] text-[#d4af37] uppercase tracking-widest font-semibold">{post.data.category || 'Article'}</span>
              <h4 class="font-serif-luxury text-sm font-semibold text-stone-200 mt-1 hover:text-[#d4af37] transition-colors">
                <a href={'/blog/' + post.id + '/'}>{post.data.title}</a>
              </h4>
            </div>
            <a href={'/blog/' + post.id + '/'} class="text-xs text-[#d4af37] whitespace-nowrap pt-1 font-semibold">
              Lire →
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
