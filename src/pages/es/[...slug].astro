---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog-es');
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout title={post.data.title + ' — Villa Prestige Saint-Barth'} description={post.data.description} lang="es">
  <article class="py-14 bg-[#060606]">
    <div class="mx-auto max-w-3xl px-4 sm:px-6">
      <div class="flex items-center gap-2 text-xs text-stone-400 mb-8 font-semibold">
        <a href="/es/" class="hover:text-[#d4af37]">Edición en Español</a>
        <span>/</span>
        <span class="text-[#d4af37]">{post.data.category}</span>
      </div>
      <header class="border-b border-stone-800 pb-8 mb-8">
        <h1 class="font-serif-luxury text-2xl sm:text-4xl font-bold text-white tracking-tight leading-snug">
          {post.data.title}
        </h1>
        <p class="mt-3 text-xs text-stone-400 font-serif-luxury italic">Villa Prestige Saint-Barth — Crónica Exclusiva</p>
      </header>
      <div class="prose prose-invert prose-stone max-w-none prose-headings:font-serif-luxury prose-headings:font-bold prose-headings:text-white prose-a:text-[#d4af37] leading-relaxed text-stone-300 font-light text-base">
        <Content />
      </div>
      <footer class="mt-14 border-t border-stone-800 pt-8 text-xs text-stone-400">
        <a href="/es/" class="text-[#d4af37] hover:underline font-semibold uppercase tracking-wider text-[11px]">← Volver a los artículos en español</a>
      </footer>
    </div>
  </article>
</Layout>
